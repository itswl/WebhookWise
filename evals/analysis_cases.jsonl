# WebhookWise analysis eval corpus. One JSON object per line; '#' lines are notes.
# See evals/README.md. Fields: id, source, parsed_data, expected{importance,
# triage_verdict}, origin, labeled_by. Omit `expected` for an unlabelled case.
#
# The seed below locks behaviour that production paid to discover. Cases mined
# from real traffic (scripts/eval_analysis.py export) carry an `event N` origin.
{"id": "payment-backlog-arrives-as-info", "source": "volcengine", "parsed_data": {"RuleName": "充值订单积压", "Level": "info", "message": "充值队列积压 1200 单，持续 8 分钟"}, "expected": {"importance": "high", "triage_verdict": "act_now"}, "origin": "regression: 15 live payment alerts arrived Level=info and were filed low (ai_analyzer content floor)", "labeled_by": "seed"}
