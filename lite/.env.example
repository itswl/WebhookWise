# WebhookWise Lite — complete configuration reference.
#
# Every variable is OPTIONAL: with an empty file the container still starts,
# still triages, and still records why each alert was or wasn't delivered.
# Copy to .env and pass with `docker run --env-file .env`.
#
#   cp lite/.env.example .env && chmod 600 .env


# ======================== Storage ========================

# SQLite file. Keep it on a mounted volume or every restart starts empty.
DB_PATH=/data/webhookwise.db


# ======================== Authentication ========================
#
# Both are empty by default so the first run needs no setup — the right trade
# for a laptop and the WRONG one for anything reachable from a network you do
# not control. Set both before exposing this.
#
# Generate: openssl rand -hex 24
#
# NOTE: these guard WRITES only. The dashboard and the read APIs
# (/api/decisions, /api/stats, /api/rules, /api/silences) are unauthenticated
# by design, so anyone who can reach the port can read your alert content. Put
# the whole thing behind a reverse-proxy auth layer if that matters.

# Required in the X-Ingest-Token header on POST /webhook/{source}.
INGEST_TOKEN=

# Required in the X-Admin-Token header to create/delete rules and silences.
ADMIN_TOKEN=


# ======================== Suppression windows ========================
#
# These two do DIFFERENT jobs and must not be set to the same magnitude:
#   dedup    collapses a BURST of the identical alert
#   cooldown paces RE-notification of an identity that keeps firing
# Cooldown only ever gets a say when it is the LONGER of the two. With
# DEDUP_WINDOW_SECONDS >= COOLDOWN_SECONDS the dedup gate catches every
# candidate first and the cooldown gate can never fire.

# An identical alert arriving inside this window is skipped as `duplicate`.
DEDUP_WINDOW_SECONDS=300

# Minimum gap between deliveries of the same identity TO THE SAME RULE. Scoped
# per rule so a chatty on-call target cannot silence an archive sink that wants
# the full stream; the alert is only skipped as `cooldown` when every matching
# rule is cooling. 0 disables the gate.
COOLDOWN_SECONDS=1800


# ======================== AI triage ========================
#
# Optional. Empty key = keyword-rule triage only, which is a floor rather than
# a degraded mode: every LLM failure (absent, slow, erroring, unparseable) also
# lands here, and the decision trace records `route=rule` so you can always see
# which path produced a judgement.
#
# Triage runs AFTER the dedup and silence gates, so duplicate and silenced
# alerts cost ZERO API calls — a storm of 1000 identical alerts makes 1 call.

# Any OpenAI-compatible key. Empty = AI off.
OPENAI_API_KEY=

# API base URL; "/chat/completions" is appended.
#   OpenAI    https://api.openai.com/v1
#   DeepSeek  https://api.deepseek.com
#   OpenRouter https://openrouter.ai/api/v1
OPENAI_API_URL=https://api.openai.com/v1

OPENAI_MODEL=gpt-4o-mini

# Per-request timeout. On timeout the alert falls back to rule triage rather
# than blocking the pipeline.
AI_TIMEOUT_SECONDS=20


# ======================== Delivery ========================
#
# Deliveries go through a SQLite outbox: the decision is committed first, then
# delivered separately, so a flaky target can never lose a decision. Each
# delivery gets 4 attempts before it is marked `exhausted`.

# How often the background loop looks for due deliveries.
OUTBOX_POLL_SECONDS=2

# Delay before retrying a failed delivery.
OUTBOX_BACKOFF_SECONDS=15
