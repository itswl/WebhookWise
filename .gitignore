# Temporary and backup files
*.sh~
*.bak
.env.bak*
*.tmp
backups/
deploy/compose/backups/
.coverage
coverage.xml
htmlcov/
# Exclude build children (not the directory itself, or the negation below
# could never re-include anything inside it).
build/*
# The exported OpenAPI contract is tracked and CI-enforced.
!build/openapi/
.DS_Store
.qoder/
openclaw-main/

# Local virtualenv
.venv/
# Keep local Claude state out, but ship the skills pointer. The real tree lives
# in .agents/skills; .claude/skills is a symlink to it, because Claude Code has
# no configurable skills path.
#
# No trailing slash on the negation. `!.claude/skills/` only ever matched a
# DIRECTORY, so the moment this became a symlink it was silently ignored again
# and the pointer would not have shipped.
.claude/*
!.claude/skills

# The alertmanager bypass receiver's URL: a chat webhook token, written by the
# deploy from ALERT_BYPASS_WEBHOOK_URL. Ignored by class, not by exact name — a
# .bak of a credential file is the same credential.
deploy/observability/alertmanager/bypass-url*

# hookrelay scrape credential (per host)
deploy/observability/prometheus/hookrelay.token
deploy/observability/prometheus/hookjudge.token

# 真实资产标识符清单：只在本地与 CI secret 里
.estate-identifiers
# A .bak of that list is the same leak with a different name, and `git add -A`
# will stage one. assert_no_estate_identifiers.py reads `git ls-files`, which
# includes STAGED files — that is how it caught exactly this once.
.estate-identifiers.bak*
